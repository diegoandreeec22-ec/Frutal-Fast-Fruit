# --- Supabase (Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SERVER ONLY. Never expose to the browser, never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App ---
# Public URL of the app (used in invitation links and QR codes)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (Resend) ---
RESEND_API_KEY=re_xxxxxxxx
# Must be an address on a domain verified in Resend
EMAIL_FROM="Frutal Fast Fruit <alertas@tu-dominio.pe>"

# --- Notification dispatcher ---
# Shared secret for the cron that calls POST /api/notifications/send
CRON_SECRET=generate-a-long-random-string
